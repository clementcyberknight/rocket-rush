{
  "name": "cubeworld",
  "version": "0.1.0",
  "description": "A browser-based 3D rocket runner game.",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "@dynamic-labs/sdk-react-core": "^4.94.0",
    "@dynamic-labs/solana": "^4.94.0",
    "@react-three/drei": "^5.3.1",
    "@react-three/fiber": "^6.2.2",
    "react": "^18.3.1",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.3.1",
    "three": "^0.135.0",
    "zustand": "^3.5.2"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "cross-env": "^7.0.3",
    "react-scripts": "^5.0.1"
  },
  "scripts": {
    "start": "cross-env HOST=0.0.0.0 NODE_OPTIONS=\"--openssl-legacy-provider --trace-deprecation\" react-scripts start",
    "build": "cross-env CI=false GENERATE_SOURCEMAP=false NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
    "test": "cross-env NODE_OPTIONS=--openssl-legacy-provider react-scripts test",
    "eject": "cross-env NODE_OPTIONS=--openssl-legacy-provider react-scripts eject"
  },
  "engines": {
    "node": ">=18 <23",
    "npm": ">=9"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
